#!/usr/bin/env python
import json

teachings = {
    'accepts': [
        'activities - do something',
        'contributing - help someone',
        'comparisons - compare it with something',
        'emotions - create new emotions',
        'pushing away - put it on the shelf',
        'thoughts - think about something else',
        'sensations - feel something different',
    ],
    'improve': [
        'imagery - look at something nice',
        'meaning - remind yourself why',
        'prayer - talk to your higher power',
        'relaxation - do something that relaxes you',
        'one thing at a time - slow down and choose',
        'vacation - take a long break and go somewhere',
        'encouragement - talk to yourself',
    ],
}


def main():
    print(json.dumps(teachings, indent=2))


if __name__ == '__main__':
    main()
